# ==============================================================================
# SwiftCart Uganda - Environment Variable Template (.env.example)
# IMPORTANT: Provide names and format examples only. NEVER commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Data source switch: "mock" (default, local mock repositories) or "firebase"
VITE_DATA_SOURCE=mock

# Firebase Web App SDK Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Asset CDN Base URL (leave empty for local public/ assets)
VITE_ASSET_BASE=

# ------------------------------------------------------------------------------
# 2. Backend Server & Cloud Functions (Express / Cloud Functions v2)
# ------------------------------------------------------------------------------
# Server port for local development (default: 3001)
PORT=3001
API_PORT=3001

# Environment mode: development | production | test
NODE_ENV=development

# Frontend application URL (used for CORS allowlist and redirect URLs)
APP_URL=http://localhost:5173

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Google Cloud / Firebase Project ID
GCLOUD_PROJECT=
FIREBASE_PROJECT_ID=

# Path to service account JSON key file (for local admin script runs outside emulator)
# In production Cloud Functions, default Application Default Credentials (ADC) are used.
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 3. Pesapal 3.0 Payment Gateway (Configured in Firebase Secrets in production)
# ------------------------------------------------------------------------------
# Pesapal environment mode: "sandbox" (for testing) or "live" (production)
PESAPAL_ENV=sandbox

# Pesapal API 3.0 Consumer Key (obtained from Pesapal merchant dashboard)
PESAPAL_CONSUMER_KEY=

# Pesapal API 3.0 Consumer Secret (obtained from Pesapal merchant dashboard)
PESAPAL_CONSUMER_SECRET=

# Pesapal Registered IPN ID (UUID returned from RegisterIPN endpoint)
PESAPAL_IPN_ID=

# ------------------------------------------------------------------------------
# 4. Local Firebase Emulators Configuration
# ------------------------------------------------------------------------------
# Uncomment when running against local Firebase Emulators:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
